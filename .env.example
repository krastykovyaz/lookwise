# eBay Browse API (Sandbox for now)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# DeepSeek (server-side only, never exposed to the browser)
DEEPSEEK_API_KEY=

# Test-only overrides. Leave unset in normal use — they exist so the whole
# search / product-detail flow can be exercised against a local stub.
# EBAY_API_BASE_URL=
# DEEPSEEK_BASE_URL=

# --- Public app origin (required for shareable Look/Item links) --------
# The canonical, publicly-reachable URL of this deployment — used for
# og:url / canonical / the Share button, so shared links are never
# accidentally generated as http://localhost:3000/... (which Telegram
# and other social crawlers cannot fetch). No trailing slash.
# Leave unset in local dev — metadata/canonical URLs fall back to the
# actual request host (see lib/url.ts), which will correctly be
# localhost; that's expected, not a bug, since a local server isn't
# reachable from Telegram either way. REQUIRED in production.
NEXT_PUBLIC_APP_URL=https://compass.example.com

# --- Scheduled maintenance (log/data retention) -------------------------
# Shared secret an external cron/scheduler must send to trigger the
# daily cleanup sweep at POST /api/maintenance/cleanup (see
# src/lib/maintenance/cleanup.ts). Required in production — the route
# 503s without it rather than accepting unauthenticated requests.
# Generate one with: openssl rand -base64 32
MAINTENANCE_CLEANUP_SECRET=

# --- Database ---------------------------------------------------------
# SQLite for local dev/MVP. "file:" prefix + a path relative to the
# project root. See README "Migrating to PostgreSQL" for moving this
# to a postgres:// connection string later.
DATABASE_URL="file:./dev.db"

# --- Auth.js (NextAuth v5) ----------------------------------------------
# Random 32+ byte secret used to sign/encrypt auth cookies. Generate one
# with: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth — create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Resend (transactional email) ----------------------------------------
# Server-side only — never exposed to the client. Get a key at
# https://resend.com/api-keys
RESEND_API_KEY=
# Must be a verified sender/domain in your Resend account.
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=Lookwise

# --- NOWPayments (crypto payments — config/connectivity foundation only;
# the actual subscription/checkout flow is not implemented yet, see
# src/lib/payments/nowpayments) --------------------------------------
# Server-side only — NEVER expose these to the client, never prefix
# with NEXT_PUBLIC_. Get sandbox keys at https://account-sandbox.nowpayments.io,
# production keys at https://account.nowpayments.io — these are two
# separate accounts with separate keys, not one key that works for both.
NOWPAYMENTS_API_KEY=
# HMAC-SHA512 secret NOWPayments signs IPN (webhook) callbacks with —
# from your NOWPayments dashboard's IPN settings. The webhook route
# that verifies this isn't built yet; required once it is.
NOWPAYMENTS_IPN_SECRET=
# Full API base URL — also selects sandbox vs production (mirrors
# EBAY_API_BASE_URL/EBAY_ENV's pattern). Leave unset for the sandbox
# default (https://api-sandbox.nowpayments.io). Set to
# https://api.nowpayments.io for production, paired with a production
# NOWPAYMENTS_API_KEY from the production account.
# NOWPAYMENTS_API_URL=
