    "verify:explore": "tsx --conditions=react-server scripts/verify-explore-pagination.ts",
    "verify:look": "tsx --conditions=react-server scripts/verify-look.ts",
    "verify:auth": "tsx --conditions=react-server scripts/verify-auth.ts",
    "verify:signals": "tsx --conditions=react-server scripts/verify-signals.ts",
    "verify:session7": "tsx --conditions=react-server scripts/verify-session7.ts",
    "verify:activity": "tsx --conditions=react-server scripts/verify-activity.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/lib/db/migrate.ts",
